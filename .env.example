# Copy to .env and fill in real values. Never commit .env.

# Required — Composio (GitHub + Gmail tools)
COMPOSIO_API_KEY=your_composio_api_key
COMPOSIO_USER_ID=funny-news

# Required — Gemini (AI code analysis summaries)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Required — GitHub activity email recipient
ACTIVITY_EMAIL_RECIPIENT=you@example.com

# Optional — GitHub activity tuning
# GITHUB_ACTIVITY_HOURS=24
# GITHUB_ACTIVITY_MAX_REPOS=10
# GITHUB_ACTIVITY_MAX_COMMITS=5
# GITHUB_ACTIVITY_AI_MODEL=gemini-2.5-flash

# Optional — Composio OAuth (auto-detected if unset)
# COMPOSIO_GMAIL_AUTH_CONFIG_ID=
# COMPOSIO_GITHUB_AUTH_CONFIG_ID=
